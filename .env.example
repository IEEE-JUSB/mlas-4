# Get the URL and Key from your Supabase project's API settings
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay payment configuration
# Get these from https://dashboard.razorpay.com/apikeys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay webhook configuration
# Generate webhook secret in Razorpay dashboard: https://dashboard.razorpay.com/webhooks
# Razorpay webhook secret for signature verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Early-bird pricing configuration (seat-based, not time-based)
# Early bird pricing: IEEE ₹499, Non-IEEE ₹599 (10 IEEE seats, 20 Non-IEEE seats)
# Regular pricing: IEEE ₹599, Non-IEEE ₹699

# WhatsApp group link for workshop participants
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your_invite_link

# Resend email configuration for sending receipts
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL=your_email@example.com
