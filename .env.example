# Get the URL and Key from your Supabase project's API settings
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL for the application (used for absolute URLs in emails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Razorpay payment configuration
# Get these from https://dashboard.razorpay.com/apikeys
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay webhook configuration
# Generate webhook secret in Razorpay dashboard: https://dashboard.razorpay.com/webhooks
# Razorpay webhook secret for signature verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Early-bird pricing configuration (seat-based, not time-based)
# Pricing in paise (Razorpay uses the smallest currency unit)
# Early bird pricing: IEEE ₹499, Non-IEEE ₹599
# Regular pricing: IEEE ₹599, Non-IEEE ₹699
EARLY_BIRD_IEEE_PRICE=49900
EARLY_BIRD_NON_IEEE_PRICE=59900
REGULAR_IEEE_PRICE=59900
REGULAR_NON_IEEE_PRICE=69900

# WhatsApp group link for workshop participants
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your_invite_link

# Resend email configuration for sending receipts
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL=your_email@example.com
